# OpenRouter API Configuration
# Sign up at https://openrouter.ai to get your API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Configuration
# Default model for main processing (recommended: openai/gpt-4o or anthropic/claude-3.5-sonnet)
DEFAULT_MODEL=openai/gpt-4o

# Fast model for quick processing (recommended: openai/gpt-4o-mini)
FAST_MODEL=openai/gpt-4o-mini

# Token limits
DEFAULT_MAX_TOKENS=4000
GPT_4O_CONTEXT_WINDOW=128000

# Available models through OpenRouter:
# OpenAI: openai/gpt-4o, openai/gpt-4o-mini, openai/gpt-4
# Anthropic: anthropic/claude-3.5-sonnet, anthropic/claude-3-opus, anthropic/claude-3-haiku
# Google: google/gemini-pro-1.5
# Other: deepseek/deepseek-chat

# Legacy compatibility (if migrating from previous version)
# These will be automatically mapped to OpenRouter models if OPENROUTER_API_KEY is set
# CLAUDE_API_KEY=your_claude_key_here
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
# OPENAI_MODEL=gpt-4o
# OPENAI_FAST_MODEL=gpt-4o-mini