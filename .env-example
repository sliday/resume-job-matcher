# One key is enough for the mode you use (--api anthropic | openai | openrouter)
CLAUDE_API_KEY='your-anthropic-api-key'
OPENAI_API_KEY='your-openai-api-key'
OPENROUTER_API_KEY='your-openrouter-api-key'

# Model pins are commented out on purpose: uncommenting one overrides the code
# default in matcher/config.ts, which is where the current recommended model lives.
# A stale pin here silently costs you money (gpt-5 is 6x gpt-5.6-luna per token).
# ANTHROPIC_MODEL="claude-sonnet-4-5"
# OPENAI_MODEL="gpt-5.6-luna"
# OPENROUTER_MODEL="openrouter/auto"
DEFAULT_MAX_TOKENS=1000
GPT_4O_CONTEXT_WINDOW=128000
